    "lab:p09:wrong-environment": "node scripts/run-focused-work.mjs tests/work/p09_seeded_bugs/wrong-environment.spec.ts",
    "lab:p10": "node scripts/run-focused-work.mjs tests/work/p10_ci.spec.ts",
    "lab:p11": "node scripts/run-focused-work.mjs tests/work/p11_capstone.spec.ts",
    "foundation:status": "node foundations/scripts/status.mjs",
    "foundation:worked": "node foundations/scripts/run-worked.mjs",
    "foundation:test:work": "node foundations/scripts/run-suite.mjs work",
    "foundation:test:reference": "node foundations/scripts/run-suite.mjs reference",
    "foundation:typecheck": "tsc -p foundations/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "typescript": "5.9.3"
  }
