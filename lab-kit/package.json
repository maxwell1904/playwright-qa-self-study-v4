{
  "name": "playwright-qa-swp391-self-study-lab",
  "version": "4.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.mjs",
    "test": "playwright test tests/work",
    "check-kit": "playwright test tests/reference",
    "check:kit": "npm run check-kit",
    "check:types": "tsc --noEmit",
    "typecheck": "npm run check:types && npm run foundation:typecheck",
    "check:all": "npm run contract:validate && npm run zero:audit && npm run status && npm run typecheck && npm run foundation:worked && npm run foundation:test:reference && npm run lab:j01 && npm run lab:j06:check && npm run check:kit",
    "contract:validate": "node scripts/validate-contract.mjs",
    "zero:audit": "node scripts/audit-zero-readiness.mjs",
    "status": "node scripts/status.mjs",
    "status:verify": "node scripts/status.mjs --run-reference",
    "test:ui": "playwright test tests/work --ui",
    "show-report": "playwright show-report",
    "lab:qa00": "node foundations/scripts/run-suite.mjs work QA00",
    "lab:qa00:reference": "node foundations/scripts/run-suite.mjs reference QA00",
    "lab:js01": "node foundations/scripts/run-suite.mjs work JS01",
    "lab:js02": "node foundations/scripts/run-suite.mjs work JS02",
    "lab:js03": "node foundations/scripts/run-suite.mjs work JS03",
    "lab:js04": "node foundations/scripts/run-suite.mjs work JS04",
    "lab:js05": "node foundations/scripts/run-suite.mjs work JS05",
    "lab:js05:monolith": "node foundations/work/js05-monolith.mjs",
