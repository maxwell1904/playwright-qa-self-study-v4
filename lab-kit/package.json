    "lab:js05:independent:reference": "node labs/js05/laundry-data-tools/reference/run.mjs",
    "lab:js06": "node foundations/scripts/run-suite.mjs work JS06",
    "lab:js06:predict": "node labs/js06/predict.mjs",
    "lab:js07": "node foundations/scripts/run-suite.mjs work JS07",
    "lab:js08": "node scripts/run-focused-work.mjs --foundation=JS08 tests/work/foundation/js08_bridge.spec.ts",
    "lab:ts01": "node foundations/scripts/run-suite.mjs work TS01",
    "lab:ts01:input": "node foundations/fixtures/ts01-starter.mjs",
    "lab:ts02": "node foundations/scripts/run-suite.mjs work TS02",
    "lab:ts03": "node foundations/scripts/run-suite.mjs work TS03",
    "lab:ts04": "node scripts/run-focused-work.mjs --foundation=TS04 tests/work/foundation/ts04_bridge.spec.ts",
    "lab:j01": "node --test labs/j01/collection-guard.test.mjs",
    "lab:j04": "node labs/git-toy/create.mjs",
    "lab:j06:check": "node labs/docker/check-compose.mjs",
    "lab:p01": "node scripts/run-focused-work.mjs tests/work/p01_anatomy.spec.ts",
    "lab:p02": "node scripts/run-focused-work.mjs tests/work/p02_locators.spec.ts",
    "lab:p03": "node scripts/run-focused-work.mjs tests/work/p03_sync.spec.ts",
    "lab:p04": "node scripts/run-focused-work.mjs tests/work/p04_controls.spec.ts",
    "lab:p05": "node scripts/run-focused-work.mjs tests/work/p05_isolation.spec.ts",
    "lab:p06": "node scripts/run-focused-work.mjs tests/work/p06_auth.spec.ts",
    "lab:p07": "node scripts/run-focused-work.mjs tests/work/p07_refactor",
    "lab:p08": "node scripts/run-focused-work.mjs tests/work/p08_api.spec.ts",
    "lab:p09": "node scripts/run-focused-work.mjs tests/work/p09_seeded_bugs",
    "lab:p09:missing-await": "node scripts/run-focused-work.mjs tests/work/p09_seeded_bugs/missing-await.spec.ts",
